# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host/db?sslmode=require"  # Neon pooled connection string

# Direct (unpooled) Neon connection used by drizzle-kit migrations. Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# Better Auth. Secret: at least 32 characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
# Public origin (optional; inferred from the request when unset), e.g. http://localhost:5173
BETTER_AUTH_URL=""

# Google sign-in (optional; hidden unless both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Lets the first person sign up as admin while no users exist (optional)
BOOTSTRAP_INVITE_CODE=""
